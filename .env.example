PORT=8080
DEV_MODE=development
MONGO_URL=mongodb://127.0.0.1:27017/nodejs-secure-rest-api
JWT_SECRET=change_me_please
TRUST_PROXY=false
CORS_ORIGIN=*
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=20
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3 (prepare for AWS phase)
# S3_USE_USER_PREFIX=true (optional: store object key as userId/filename)
S3_USE_USER_PREFIX=false
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
MAX_USER_STORAGE_MB=200
SEED_ADMIN_ON_START=false
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=0900000000
ADMIN_ADDRESS=HCMC
